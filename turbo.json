{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": [
        "eslint.config.mjs",
        ".prettierrc",
        "packages/config/**"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["build/**", "stats.html"]
        },
        "storybook:build": {
            "dependsOn": ["^build"],
            "outputs": ["storybook-static/**"]
        },
        "test": {
            "dependsOn": [],
            "outputs": []
        },
        "test:e2e": {
            "dependsOn": [],
            "outputs": [],
            "cache": false
        },
        "lint": {
            "dependsOn": [],
            "outputs": []
        },
        "prettier": {
            "dependsOn": [],
            "outputs": []
        }
    }
}
