{
  "name": "@gamecrafters/base-ui",
  "version": "0.0.13",
  "description": "An implementation of GameCrafters' Base UI Design System using React.",
  "main": "build/main.cjs.js",
  "module": "build/main.esm.js",
  "types": "build/main.d.ts",
  "exports": {
    ".": {
      "types": "./build/main.d.ts",
      "import": "./build/main.esm.js",
      "require": "./build/main.cjs.js"
    },
    "./main.css": "./build/styles/main.css",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "jest --config tests/jest.config.js",
    "storybook": "storybook dev -p 9000",
    "storybook:build": "storybook build",
    "lint": "npx eslint src tests",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "npx prettier src tests --check",
    "prettier:fix": "npm run prettier -- --write",
    "format": "npm run lint:fix && npm run prettier:fix",
    "clean": "rm -rf build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donaldturinglee/base-ui.git"
  },
  "keywords": [
    "base-ui",
    "react",
    "typescript",
    "rollup",
    "storybook",
    "jest"
  ],
  "author": "donaldturinglee <donaldturinglee@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/donaldturinglee/base-ui/issues"
  },
  "homepage": "https://github.com/donaldturinglee/base-ui#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.37.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-themes": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/react-dom": "^19.2.3",
    "@types/react-is": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "babel-jest": "^30.2.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-storybook": "10.4.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "jiti": "^2.6.1",
    "postcss": "^8.5.15",
    "prettier": "^3.6.2",
    "rollup": "^4.52.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-visualizer": "^6.0.4",
    "storybook": "^10.4.2",
    "tailwindcss": "^4.3.2",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "@gamecrafters/base-ui-icons": "^0.0.8",
    "@lexical/code-core": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/markdown": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@oddbird/popover-polyfill": "^0.7.1",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "lexical": "^0.49.0",
    "react-is": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "shiki": "^4.4.1",
    "tailwind-merge": "^3.6.0"
  }
}
