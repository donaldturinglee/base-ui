{
  "name": "@gamecrafters/base-ui",
  "version": "0.0.34",
  "description": "An implementation of GameCrafters' Base UI Design System using React.",
  "exports": {
    "./react": {
      "types": "./build/main.d.ts",
      "import": "./build/main.esm.js",
      "require": "./build/main.cjs.js"
    },
    "./main.css": "./build/styles/main.css",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly --noEmit false && rolldown -c && tailwindcss -i ./src/styles/main.css -o ./build/styles/main.css --minify",
    "test": "vitest run",
    "lint": "npx eslint src --config ../config/eslint/react.js",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "npx prettier src --check",
    "prettier:fix": "npm run prettier -- --write",
    "format": "npm run lint:fix && npm run prettier:fix",
    "clean": "rm -rf build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gamecrafters-io/base-ui.git",
    "directory": "packages/react"
  },
  "keywords": [
    "base-ui",
    "react",
    "typescript",
    "rolldown",
    "storybook",
    "vitest",
    "playwright"
  ],
  "author": "donaldturinglee <donaldturinglee@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gamecrafters-io/base-ui/issues"
  },
  "homepage": "https://github.com/gamecrafters-io/base-ui#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@gamecrafters/eslint-config": "*",
    "@gamecrafters/typescript-config": "*",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react-dom": "^19.2.3",
    "@types/react-is": "^19.2.0",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "rolldown": "^1.2.3",
    "rollup-plugin-visualizer": "^6.0.4",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@gamecrafters/base-ui-icons": "^0.0.12",
    "@lexical/code-core": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/markdown": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@oddbird/popover-polyfill": "^0.7.1",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "lexical": "^0.49.0",
    "ol": "^10.10.0",
    "react-is": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "shiki": "^4.4.1",
    "tailwind-merge": "^3.6.0"
  }
}
