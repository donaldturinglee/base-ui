{
    "extends": "../config/typescript/react.json",
    // What is left here is what is read against this package rather than against the config it
    // extends: where the sources are, and where what is built from them goes
    "compilerOptions": {
        "declarationDir": "build",
        "outDir": "build",
        "rootDir": "src"
    },
    "include": ["src/**/*"],
    "exclude": [
        "node_modules",
        "build",
        "src/tests",
        "**/*.stories.tsx",
        "**/*.test.ts",
        "**/*.test.tsx"
    ]
}
