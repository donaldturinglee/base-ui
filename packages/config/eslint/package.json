{
  "name": "@gamecrafters/eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "The ESLint configuration the packages of the workspace are linted under.",
  "type": "module",
  "scripts": {
    "lint": "npx eslint base.js react.js --config ./base.js",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "npx prettier base.js react.js --check",
    "prettier:fix": "npm run prettier -- --write",
    "format": "npm run lint:fix && npm run prettier:fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gamecrafters-io/base-ui.git",
    "directory": "packages/config/eslint"
  },
  "keywords": [
    "base-ui",
    "config",
    "eslint"
  ],
  "author": "donaldturinglee <donaldturinglee@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gamecrafters-io/base-ui/issues"
  },
  "homepage": "https://github.com/gamecrafters-io/base-ui#readme",
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-storybook": "10.4.2",
    "globals": "^14.0.0",
    "typescript-eslint": "^8.46.0"
  }
}
