{
  "name": "@gamecrafters/base-ui-mcp",
  "version": "0.0.6",
  "description": "An MCP server implementation that connects AI tools to GameCrafters' Base UI Design System.",
  "type": "module",
  "bin": {
    "base-ui-mcp": "build/main.js"
  },
  "exports": {
    "./registry.json": "./build/registry.json",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && rolldown -c && node build/generate.js",
    "start": "node build/main.js",
    "test": "vitest run",
    "lint": "npx eslint src --config ../config/eslint/base.js",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "npx prettier src --check",
    "prettier:fix": "npm run prettier -- --write",
    "format": "npm run lint:fix && npm run prettier:fix",
    "clean": "rm -rf build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gamecrafters-io/base-ui.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "base-ui",
    "mcp",
    "model-context-protocol",
    "react",
    "typescript"
  ],
  "author": "donaldturinglee <donaldturinglee@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gamecrafters-io/base-ui/issues"
  },
  "homepage": "https://github.com/gamecrafters-io/base-ui#readme",
  "devDependencies": {
    "@gamecrafters/base-ui": "*",
    "@gamecrafters/eslint-config": "*",
    "@gamecrafters/typescript-config": "*",
    "@types/node": "^26.2.0",
    "rolldown": "^1.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
